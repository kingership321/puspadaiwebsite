generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  passwordHash    String?
  phone           String?
  role            String         @default("SEEKER") // SEEKER, OWNER, AGENT, ADMIN
  avatarUrl       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  agents          Agent[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  inquiries       Inquiry[]
  ownedProperties Property[]     @relation("OwnerProperties")
}

model Agency {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  logoUrl     String?
  description String?
  website     String?
  email       String?
  phone       String?
  address     String?
  cityId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agents      Agent[]
  properties  Property[]
  inquiries   Inquiry[]
}

model Agent {
  id           String     @id @default(cuid())
  userId       String?
  agencyId     String
  name         String
  slug         String     @unique
  photoUrl     String?
  bio          String?
  languages    String?
  serviceAreas String?
  email        String?
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id])
  agency       Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  properties   Property[]
  inquiries    Inquiry[]
}

model City {
  id          String     @id @default(cuid())
  name        String
  nameJa      String?
  slug        String     @unique
  state       String?
  country     String     @default("Japan")
  latitude    Float
  longitude   Float
  imageUrl    String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  areas       Area[]
  properties  Property[]
}

model Area {
  id          String     @id @default(cuid())
  cityId      String
  name        String
  nameJa      String?
  slug        String     @unique
  postalCode  String?
  latitude    Float
  longitude   Float
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  city        City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties  Property[]
}

model Property {
  id              String            @id @default(cuid())
  slug            String            @unique
  listingType     String            // RENT, SALE
  propertyType    String            // MANSION, APARTMENT, HOUSE, TOWNHOUSE, VILLA, STUDIO
  title           String
  titleJa         String?
  description     String
  descriptionJa   String?
  price           Float             // in JPY (e.g. 145000 for rent, 68000000 for sale)
  deposit         Float?            // 敷金 (Shikikin)
  keyMoney        Float?            // 礼金 (Reikin)
  managementFee   Float?            // 管理費・共益費
  currency        String            @default("JPY")
  layout          String?           // 1R, 1K, 1DK, 1LDK, 2LDK, 3LDK
  structure       String?           // RC, SRC, 鉄骨造, 木造
  stationName     String?           // e.g. 渋谷駅 (Shibuya Station)
  stationLine     String?           // e.g. JR山手線 (JR Yamanote Line)
  walkMinutes     Int?              // e.g. 5 (5 min walk)
  bedrooms        Int
  bathrooms       Float
  area            Float             // in sqm or sqft
  landArea        Float?
  floor           Int?
  totalFloors     Int?
  yearBuilt       Int?
  furnished       Boolean           @default(false)
  parking         Boolean           @default(false)
  address         String
  cityId          String
  areaId          String
  agencyId        String?
  agentId         String?
  ownerId         String?
  latitude        Float
  longitude       Float
  status          String            @default("PUBLISHED") // DRAFT, PENDING_REVIEW, PUBLISHED, PAUSED, SOLD, RENTED, ARCHIVED
  featured        Boolean           @default(false)
  rejectionReason String?
  publishedAt     DateTime?         @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  city            City              @relation(fields: [cityId], references: [id])
  neighborhood    Area              @relation(fields: [areaId], references: [id])
  agency          Agency?           @relation(fields: [agencyId], references: [id])
  agent           Agent?            @relation(fields: [agentId], references: [id])
  owner           User?             @relation("OwnerProperties", fields: [ownerId], references: [id])
  images          PropertyImage[]
  amenities       PropertyAmenity[]
  favorites       Favorite[]
  inquiries       Inquiry[]
  reports         ListingReport[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isMain     Boolean  @default(false)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id         String            @id @default(cuid())
  name       String
  nameJa     String?
  slug       String            @unique
  category   String            @default("General") // Interior, Exterior, Building, Japanese
  icon       String?

  properties PropertyAmenity[]
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  amenityId  String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  notes      String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model SavedSearch {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  searchType            String   @default("ALL") // RENT, SALE, ALL
  filtersJson           String   // Stored as JSON string
  notificationFrequency String   @default("DAILY") // INSTANT, DAILY, WEEKLY, OFF
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id                   String   @id @default(cuid())
  propertyId           String
  userId               String?
  agencyId             String?
  agentId              String?
  name                 String
  email                String
  phone                String?
  message              String
  preferredViewingTime String?
  inquiryType          String   @default("MESSAGE") // MESSAGE, TOUR
  status               String   @default("NEW") // NEW, CONTACTED, VIEWING_SCHEDULED, CLOSED
  createdAt            DateTime @default(now())

  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user                 User?    @relation(fields: [userId], references: [id])
  agency               Agency?  @relation(fields: [agencyId], references: [id])
  agent                Agent?   @relation(fields: [agentId], references: [id])
}

model ListingReport {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  reason     String   // INCORRECT_INFO, FRAUD, DUPLICATE, INAPPROPRIATE, NOT_AVAILABLE
  details    String?
  status     String   @default("OPEN") // OPEN, RESOLVED, DISMISSED
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())
}
